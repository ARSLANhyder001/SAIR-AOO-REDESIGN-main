# Set this to the public domain before deploying (for example, https://sair.example).
NEXT_PUBLIC_SITE_URL=

# Use the Supabase project URL and anon/publishable key only. Never use service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set this to SAIR's exact Uptodown listing URL after the app is published.
NEXT_PUBLIC_ANDROID_APP_URL=

# Set this to SAIR's actual App Store listing URL when available.
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/pk/search?term=SAIR%20Construction%20Real%20Estate
